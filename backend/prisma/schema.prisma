model PaymentOperation {
  id                String                 @id @default(uuid()) @db.Uuid
  companyId         String                 @db.Uuid
  invoiceId         String                 @db.Uuid
  userId            String?                @db.Uuid
  amountMinor       BigInt
  currency          String                 @db.Char(3)
  method            PaymentMethod
  provider          String
  source            PaymentOperationSource @default(STAFF)
  reference         String?
  idempotencyKey    String
  status            PaymentOperationStatus @default(PENDING)
  providerPaymentId String?
  ledgerPaymentId   String?
  errorMessage      String?
  retryCount        Int                    @default(0)
  nextRetryAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  company           Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice           Invoice                @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user              User?                  @relation("PaymentOperationCreators", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, invoiceId, status])
  @@index([status, createdAt])
  @@index([status, nextRetryAt])
  @@map("payment_operations")
}

model InvoiceReminderClaim {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  invoiceId   String   @db.Uuid
  windowStart DateTime
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([companyId, invoiceId, windowStart])
  @@index([companyId, createdAt])
  @@map("invoice_reminder_claims")
}

model PortalAccessGrant {
  id                String                    @id @default(uuid()) @db.Uuid
  companyId         String                    @db.Uuid
  customerId        String                    @db.Uuid
  jobId             String?                   @db.Uuid
  scope             PortalGrantScope          @default(JOB)
  issuedBy          String?                   @db.Uuid
  linkTokenHash     String                    @unique
  linkExpiresAt     DateTime
  linkConsumedAt    DateTime?
  status            PortalGrantStatus         @default(ACTIVE)
  deactivatedAt     DateTime?
  deactivatedReason PortalDeactivationReason?
  deactivatedBy     String?                   @db.Uuid
  createdAt         DateTime                  @default(now())
  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer          Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job               Job?                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  issuer            User?                     @relation("PortalGrantIssuers", fields: [issuedBy], references: [id], onDelete: SetNull)
  sessions          PortalSession[]

  @@index([companyId, jobId, status])
  @@index([companyId, customerId, scope, status])
  @@index([status, linkExpiresAt])
  @@map("portal_access_grants")
}

model PortalSession {
  id                        String                     @id @default(uuid()) @db.Uuid
  grantId                   String                     @db.Uuid
  companyId                 String                     @db.Uuid
  customerId                String                     @db.Uuid
  jobId                     String?                    @db.Uuid
  scope                     PortalGrantScope           @default(JOB)
  sessionTokenHash          String                     @unique
  userAgentHash             String?
  createdAt                 DateTime                   @default(now())
  lastSeenAt                DateTime                   @default(now())
  expiresAt                 DateTime
  revokedAt                 DateTime?
  grant                     PortalAccessGrant          @relation(fields: [grantId], references: [id], onDelete: Cascade)
  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer                  Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job                       Job?                       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  serviceRequestUploads     ServiceRequestUpload[]
  serviceRequestAttachments ServiceRequestAttachment[]
  serviceRequestMessages    ServiceRequestMessage[]
  quoteAcceptances          QuoteAcceptance[]
  paymentSessions           PaymentSession[]

  @@index([grantId, revokedAt])
  @@map("portal_sessions")
}

model PortalAuditEvent {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  jobId        String?   @db.Uuid
  customerId   String?   @db.Uuid
  grantId      String?   @db.Uuid
  actorUserId  String?   @db.Uuid
  action       String
  resourceType String?
  resourceId   String?   @db.Uuid
  metadata     Json?
  createdAt    DateTime  @default(now())
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job          Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([companyId, jobId, createdAt(sort: Desc)])
  @@index([companyId, customerId, createdAt(sort: Desc)])
  @@index([companyId, resourceType, resourceId])
  @@map("portal_audit_events")
}
