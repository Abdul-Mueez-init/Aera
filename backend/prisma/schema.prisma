generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyMemberRole {
  OWNER
  DISPATCHER
  TECHNICIAN
}

enum CompanyMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum JobStatus {
  NEW
  QUOTING
  SCHEDULED
  EN_ROUTE
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  CANCELLED
}

enum JobType {
  DIAGNOSTIC
  REPAIR
  INSTALLATION
  MAINTENANCE
  OTHER
}

enum BookingMode {
  DISPATCHER_CONFIRMS
  SELF_SERVE_WINDOWS
}

enum AppointmentProposalStatus {
  OPEN
  PICKED
  EXPIRED
  CANCELLED
}

enum AppointmentHoldStatus {
  HELD
  CONFIRMED
  RELEASED
  EXPIRED
}

enum ServiceRequestStatus {
  SUBMITTED
  NEEDS_INFO
  QUOTING
  QUOTED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
  CLOSED
}

enum ServiceRequestSource {
  PHONE
  WALK_IN
  WEB_PORTAL
  STAFF_DIRECT
}

enum ServiceRequestEventType {
  CREATED
  STATUS_CHANGED
  INSPECTION_MARKED
  CLOSED
  CANCELLED
  REOPENED
}

enum ServiceRequestUploaderType {
  STAFF
  PORTAL
}

enum ServiceRequestAttachmentKind {
  PHOTO
  VIDEO
  DOCUMENT
}

enum ServiceRequestMessageAuthorType {
  STAFF
  CUSTOMER
}

enum JobNoteVisibility {
  INTERNAL
  CUSTOMER
}

enum JobPhotoKind {
  BEFORE
  AFTER
  OTHER
}

enum JobReviewState {
  NOT_REQUIRED
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum JobChangeRequestStatus {
  OPEN
  QUOTED
  DECLINED
  WITHDRAWN
}

enum InvoiceItemSourceType {
  QUOTE_ITEM
  JOB_PART
  AUTHORIZATION
  MANUAL
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  EXPIRED
}

enum QuoteApprovalAction {
  APPROVED
  DECLINED
}

enum QuoteAcceptanceActorType {
  STAFF
  PORTAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  OVERDUE
}

enum InvoiceKind {
  STANDARD
  DEPOSIT
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentOperationSource {
  STAFF
  PORTAL
  WEBHOOK
}

enum PaymentSessionStatus {
  OPEN
  COMPLETED
  EXPIRED
  FAILED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum NotificationType {
  JOB_SCHEDULED
  JOB_RESCHEDULED
  JOB_ASSIGNED
  QUOTE_SENT
  QUOTE_APPROVED
  QUOTE_DECLINED
  INVOICE_ISSUED
  // Already present on the live Supabase enum via migration
  // `add_invoice_payment_reminder_type` — this line only brings
  // schema.prisma back in sync with the database, it does not introduce
  // a new migration. No emitter exists yet (scheduled invoice reminders
  // are a later Phase 10 slice); email-templates.ts already has a safe
  // fallback for notification types without a template.
  INVOICE_PAYMENT_REMINDER
}

enum PortalGrantStatus {
  ACTIVE
  DEACTIVATED
}

enum PortalGrantScope {
  JOB
  WORKSPACE
}

enum PortalDeactivationReason {
  AUTO_COMPLETED
  AUTO_CANCELLED
  AUTO_MAX_AGE
  AUTO_LINK_UNUSED
  MANUAL
  REISSUED
}

enum DeviceTokenPlatform {
  ANDROID
  IOS
  WEB
}

enum NotificationOutboxChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationOutboxStatus {
  QUEUED
  PROVIDER_ACCEPTED
  DELIVERED
  FAILED
  DEAD
}

enum AiMessageRole {
  USER
  ASSISTANT
  TOOL
}

model User {
  id                         String                     @id @default(uuid()) @db.Uuid
  email                      String?                    @unique
  phone                      String?                    @unique
  passwordHash               String?
  firstName                  String
  lastName                   String
  avatarUrl                  String?
  isActive                   Boolean                    @default(true)
  memberships                CompanyMember[]
  refreshSessions            RefreshSession[]
  passwordResetTokens        PasswordResetToken[]
  assignedJobs               Job[]                      @relation("AssignedJobs")
  workingHours               TechnicianWorkingHours[]
  timeOff                    TechnicianTimeOff[]
  skills                     TechnicianSkill[]
  statusChanges              JobStatusHistory[]         @relation("JobStatusActors")
  serviceRequestEvents       ServiceRequestEvent[]      @relation("ServiceRequestEventActors")
  serviceRequestUploads      ServiceRequestUpload[]     @relation("ServiceRequestUploaders")
  serviceRequestAttachments  ServiceRequestAttachment[] @relation("ServiceRequestAttachmentUploaders")
  serviceRequestMessages     ServiceRequestMessage[]    @relation("ServiceRequestMessageAuthors")
  authoredNotes              JobNote[]                  @relation("JobNoteAuthors")
  uploadedPhotos             JobPhoto[]                 @relation("JobPhotoUploaders")
  quoteApprovalEvents        QuoteApprovalEvent[]       @relation("QuoteApprovalActors")
  quoteAcceptanceActors      QuoteAcceptance[]          @relation("QuoteAcceptanceActors")
  createdInvoices            Invoice[]                  @relation("InvoiceCreators")
  createdPayments            Payment[]                  @relation("PaymentCreators")
  createdRefunds             Refund[]                   @relation("RefundCreators")
  createdPortalTokens        CustomerPortalToken[]      @relation("PortalTokenCreators")
  issuedPortalGrants         PortalAccessGrant[]        @relation("PortalGrantIssuers")
  notifications              Notification[]             @relation("NotificationRecipients")
  deviceTokens               DeviceToken[]              @relation("DeviceTokenOwners")
  notificationOutbox         NotificationOutbox[]       @relation("NotificationOutboxRecipients")
  aiConversations            AiConversation[]           @relation("AiConversationOwners")
  presignedUploads           PresignedUpload[]          @relation("PresignedUploadRequesters")
  paymentOperations          PaymentOperation[]         @relation("PaymentOperationCreators")
  authoredFindings           JobFinding[]               @relation("JobFindingAuthors")
  assignedChangeRequests     JobChangeRequest[]         @relation("JobChangeRequestTechnicians")
  authorizedChangeRequests   JobChangeRequest[]         @relation("JobChangeRequestAuthorizers")
  reviewedJobs               Job[]                      @relation("JobReviewers")
  pickedAppointmentProposals AppointmentProposal[]      @relation("ProposalPicker")
  technicianAppointmentHolds AppointmentHold[]          @relation("HoldTechnician")
  createdAppointmentHolds    AppointmentHold[]          @relation("HoldCreator")
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  @@map("users")
}

model Company {
  id                            String                     @id @default(uuid()) @db.Uuid
  name                          String
  slug                          String                     @unique
  timezone                      String                     @default("UTC")
  travelBufferMinutes           Int                        @default(0)
  bookingMode                   BookingMode                @default(DISPATCHER_CONFIRMS)
  requireCompletionReview       Boolean                    @default(false)
  emergencyAuthorizationAllowed Boolean                    @default(false)
  defaultCurrency               String                     @default("USD") @db.Char(3)
  phone                         String?
  taxId                         String?
  logoObjectKey                 String?
  headquartersAddress           String?
  headquartersLatitude          Decimal?                   @db.Decimal(10, 7)
  headquartersLongitude         Decimal?                   @db.Decimal(10, 7)
  serviceRadiusKm               Int?
  // DEPRECATED: No longer used. Onboarding is now all-or-nothing with atomic commit.
  // Kept for backward compatibility with existing data. Will be dropped in a future migration.
  onboardingStep                Int                        @default(1)
  onboardingCompletedAt         DateTime?
  memberships                   CompanyMember[]
  refreshSessions               RefreshSession[]
  customers                     Customer[]
  serviceAddresses              ServiceAddress[]
  jobs                          Job[]
  serviceRequests               ServiceRequest[]
  serviceRequestEvents          ServiceRequestEvent[]
  serviceRequestUploads         ServiceRequestUpload[]
  serviceRequestAttachments     ServiceRequestAttachment[]
  serviceRequestMessages        ServiceRequestMessage[]
  appointmentProposals          AppointmentProposal[]
  appointmentHolds              AppointmentHold[]
  quotes                        Quote[]
  jobStatusHistories            JobStatusHistory[]
  jobNotes                      JobNote[]
  jobPhotos                     JobPhoto[]
  jobParts                      JobPart[]
  quoteItems                    QuoteItem[]
  invoiceItems                  InvoiceItem[]
  quoteApprovalEvents           QuoteApprovalEvent[]
  invoices                      Invoice[]
  invoiceCreditApplications     InvoiceCreditApplication[]
  refunds                       Refund[]
  paymentSessions               PaymentSession[]
  providerWebhookEvents         ProviderWebhookEvent[]
  payments                      Payment[]
  reviews                       CustomerReview[]
  portalTokens                  CustomerPortalToken[]
  portalGrants                  PortalAccessGrant[]
  portalSessions                PortalSession[]
  portalAuditEvents             PortalAuditEvent[]
  notifications                 Notification[]
  deviceTokens                  DeviceToken[]
  notificationOutbox             NotificationOutbox[]
  jobTrackingStates              JobTrackingState[]
  aiConversations               AiConversation[]
  counters                      CompanyCounter[]
  presignedUploads              PresignedUpload[]
  paymentOperations             PaymentOperation[]
  invoiceReminderClaims         InvoiceReminderClaim[]
  quoteAcceptances              QuoteAcceptance[]
  services                      CompanyService[]
  serviceZones                  CompanyServiceZone[]
  businessHours                 CompanyBusinessHours[]
  technicianWorkingHours        TechnicianWorkingHours[]
  technicianTimeOff             TechnicianTimeOff[]
  technicianSkills              TechnicianSkill[]
  findings                      JobFinding[]
  changeRequests                JobChangeRequest[]
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt

  @@map("companies")
}

model CompanyService {
  id                     String            @id @default(uuid()) @db.Uuid
  companyId              String            @db.Uuid
  serviceKey             String?
  name                   String
  normalizedName         String
  iconKey                String
  defaultDurationMinutes Int               @default(60)
  isCustom               Boolean           @default(false)
  company                Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  technicianSkills       TechnicianSkill[]

  @@unique([companyId, normalizedName])
  @@index([companyId, createdAt])
  @@map("company_services")
}

model CompanyBusinessHours {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  weekday   Int
  open      String
  close     String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, weekday])
  @@index([companyId, weekday])
  @@map("company_business_hours")
}

model TechnicianWorkingHours {
  id           String  @id @default(uuid()) @db.Uuid
  companyId    String  @db.Uuid
  technicianId String  @db.Uuid
  weekday      Int
  open         String
  close        String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  technician   User    @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([companyId, technicianId, weekday])
  @@index([companyId, technicianId, weekday])
  @@map("technician_working_hours")
}

model TechnicianTimeOff {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  technicianId String   @db.Uuid
  startsAt     DateTime
  endsAt       DateTime
  reason       String?
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  technician   User     @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([companyId, technicianId, startsAt, endsAt])
  @@map("technician_time_off")
}

model TechnicianSkill {
  id           String         @id @default(uuid()) @db.Uuid
  companyId    String         @db.Uuid
  technicianId String         @db.Uuid
  serviceId    String         @db.Uuid
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  technician   User           @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  service      CompanyService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([companyId, technicianId, serviceId])
  @@index([companyId, serviceId])
  @@map("technician_skills")
}

model AppointmentProposal {
  id             String                    @id @default(uuid()) @db.Uuid
  companyId      String                    @db.Uuid
  requestId      String?                   @db.Uuid
  jobId          String?                   @db.Uuid
  quoteId        String?                   @db.Uuid
  windows        Json
  pickedWindow   Json?
  status         AppointmentProposalStatus @default(OPEN)
  expiresAt      DateTime
  pickedAt       DateTime?
  pickedByUserId String?                   @db.Uuid
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  company        Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  request        ServiceRequest?           @relation(fields: [requestId, companyId], references: [id, companyId], onDelete: Cascade)
  job            Job?                      @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Cascade)
  quote          Quote?                    @relation(fields: [quoteId, companyId], references: [id, companyId], onDelete: Cascade)
  pickedBy       User?                     @relation("ProposalPicker", fields: [pickedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status, expiresAt])
  @@index([companyId, requestId])
  @@map("appointment_proposals")
}

model AppointmentHold {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @db.Uuid
  requestId       String?               @db.Uuid
  jobId           String?               @db.Uuid
  quoteId         String?               @db.Uuid
  technicianId    String?               @db.Uuid
  windowStart     DateTime
  windowEnd       DateTime
  expiresAt       DateTime
  status          AppointmentHoldStatus @default(HELD)
  createdByUserId String?               @db.Uuid
  confirmedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  request         ServiceRequest?       @relation(fields: [requestId, companyId], references: [id, companyId], onDelete: Cascade)
  job             Job?                  @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Cascade)
  quote           Quote?                @relation(fields: [quoteId, companyId], references: [id, companyId], onDelete: Cascade)
  technician      User?                 @relation("HoldTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  createdBy       User?                 @relation("HoldCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status, windowStart, windowEnd])
  @@index([companyId, jobId])
  @@map("appointment_holds")
}

model CompanyServiceZone {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  providerPlaceId String
  name            String
  latitude        Decimal  @db.Decimal(10, 7)
  longitude       Decimal  @db.Decimal(10, 7)
  isActive        Boolean  @default(true)
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, providerPlaceId])
  @@index([companyId, isActive])
  @@map("company_service_zones")
}

model CompanyMember {
  id                       String              @id @default(uuid()) @db.Uuid
  companyId                String              @db.Uuid
  userId                   String              @db.Uuid
  role                     CompanyMemberRole
  status                   CompanyMemberStatus @default(INVITED)
  invitationTokenHash      String?             @unique
  invitationTokenExpiresAt DateTime?
  company                  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@unique([companyId, userId])
  @@index([companyId, role, status])
  @@map("company_members")
}

model RefreshSession {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @db.Uuid
  userId              String    @db.Uuid
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?   @db.Uuid
  createdAt           DateTime  @default(now())
  lastUsedAt          DateTime?
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("refresh_sessions")
}

// Single-use password-reset codes. Only an HMAC of the code is stored, never the
// code itself, and a code dies after `failedAttempts` reaches the cap in
// auth/password-reset.service.ts.
model PasswordResetToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  codeHash       String
  expiresAt      DateTime
  usedAt         DateTime?
  failedAttempts Int       @default(0)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Customer {
  id                        String                     @id @default(uuid()) @db.Uuid
  companyId                 String                     @db.Uuid
  firstName                 String
  lastName                  String
  email                     String?
  phone                     String?
  notes                     String?
  status                    CustomerStatus             @default(ACTIVE)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?
  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceAddresses          ServiceAddress[]
  jobs                      Job[]
  quotes                    Quote[]
  invoices                  Invoice[]
  portalTokens              CustomerPortalToken[]
  portalGrants              PortalAccessGrant[]
  portalSessions            PortalSession[]
  portalAuditEvents         PortalAuditEvent[]
  reviews                   CustomerReview[]
  serviceRequests           ServiceRequest[]
  serviceRequestUploads     ServiceRequestUpload[]
  serviceRequestAttachments ServiceRequestAttachment[]
  serviceRequestMessages    ServiceRequestMessage[]

  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("customers")
}

model ServiceAddress {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid
  customerId      String           @db.Uuid
  label           String
  line1           String
  line2           String?
  city            String
  region          String?
  postalCode      String?
  countryCode     String           @db.Char(2)
  lat             Decimal?
  lng             Decimal?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs            Job[]
  serviceRequests ServiceRequest[]

  @@unique([id, companyId])
  @@index([companyId, customerId])
  @@map("service_addresses")
}

model Job {
  id                      String                @id @default(uuid()) @db.Uuid
  companyId               String                @db.Uuid
  customerId              String                @db.Uuid
  serviceAddressId        String                @db.Uuid
  serviceRequestId        String?               @db.Uuid
  type                    JobType               @default(OTHER)
  reviewState             JobReviewState        @default(NOT_REQUIRED)
  reviewedBy              String?               @db.Uuid
  reviewedAt              DateTime?
  reviewNote              String?
  sourceQuoteId           String?               @unique @db.Uuid
  assignedTechnicianId    String?               @db.Uuid
  jobNumber               Int
  serviceType             String
  problemDescription      String
  priority                JobPriority           @default(NORMAL)
  status                  JobStatus             @default(NEW)
  scheduledStart          DateTime?
  scheduledEnd            DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  completionSummary       String?
  handshakeVersion        Int                   @default(0)
  handshakeFailedAttempts Int                   @default(0)
  handshakeLockedUntil    DateTime?
  handshakeVerifiedAt     DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  company                 Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer                Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceAddress          ServiceAddress        @relation(fields: [serviceAddressId], references: [id], onDelete: Restrict)
  assignedTechnician      User?                 @relation("AssignedJobs", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  statusHistory           JobStatusHistory[]
  notes                   JobNote[]
  photos                  JobPhoto[]
  parts                   JobPart[]
  quotes                  Quote[]               @relation("JobQuotes")
  invoices                Invoice[]
  reviews                 CustomerReview[]
  presignedUploads        PresignedUpload[]
  portalGrants            PortalAccessGrant[]
  portalSessions          PortalSession[]
  trackingState           JobTrackingState?
  portalAuditEvents       PortalAuditEvent[]
  serviceRequest          ServiceRequest?       @relation(fields: [serviceRequestId, companyId], references: [id, companyId], onDelete: Restrict)
  sourceQuote             Quote?                @relation("QuoteSourceJob", fields: [sourceQuoteId, companyId], references: [id, companyId], onDelete: Restrict)
  basisQuotes             Quote[]               @relation("QuoteBasisJob")
  appointmentProposals    AppointmentProposal[]
  appointmentHolds        AppointmentHold[]
  findings                JobFinding[]
  changeRequests          JobChangeRequest[]
  reviewer                User?                 @relation("JobReviewers", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([companyId, jobNumber])
  @@unique([id, companyId])
  @@index([companyId, status, scheduledStart])
  @@index([companyId, assignedTechnicianId, scheduledStart])
  @@index([companyId, customerId])
  @@index([companyId, serviceAddressId])
  @@map("jobs")
}

model JobStatusHistory {
  id          String     @id @default(uuid()) @db.Uuid
  companyId   String     @db.Uuid
  jobId       String     @db.Uuid
  actorUserId String     @db.Uuid
  fromStatus  JobStatus?
  toStatus    JobStatus
  reason      String?
  createdAt   DateTime   @default(now())
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job         Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor       User       @relation("JobStatusActors", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([companyId, jobId, createdAt(sort: Desc)])
  @@index([companyId, actorUserId])
  @@map("job_status_history")
}

model JobNote {
  id           String            @id @default(uuid()) @db.Uuid
  companyId    String            @db.Uuid
  jobId        String            @db.Uuid
  authorUserId String            @db.Uuid
  body         String
  visibility   JobNoteVisibility @default(INTERNAL)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job          Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  author       User              @relation("JobNoteAuthors", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([companyId, jobId, createdAt(sort: Desc)])
  @@index([companyId, authorUserId])
  @@map("job_notes")
}

model JobPhoto {
  id         String       @id @default(uuid()) @db.Uuid
  companyId  String       @db.Uuid
  jobId      String       @db.Uuid
  uploadedBy String       @db.Uuid
  objectKey  String
  mimeType   String
  sizeBytes  BigInt
  kind       JobPhotoKind @default(OTHER)
  caption    String?
  createdAt  DateTime     @default(now())
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job        Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  uploader   User         @relation("JobPhotoUploaders", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([companyId, jobId, createdAt(sort: Desc)])
  @@index([companyId, uploadedBy])
  @@map("job_photos")
}

model JobPart {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  jobId          String   @db.Uuid
  name           String
  quantity       Decimal  @db.Decimal(10, 2)
  unitPriceMinor BigInt
  currency       String   @db.Char(3)
  createdAt      DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([companyId, jobId, createdAt(sort: Desc)])
  @@map("job_parts")
}

model JobFinding {
  id                    String   @id @default(uuid()) @db.Uuid
  companyId             String   @db.Uuid
  jobId                 String   @db.Uuid
  authorUserId          String   @db.Uuid
  summary               String
  recommendedWork       String?
  equipmentInfo         Json?
  likelyParts           Json?
  estimatedLaborMinutes Int?
  customerVisible       Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job                   Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  author                User     @relation("JobFindingAuthors", fields: [authorUserId], references: [id], onDelete: Restrict)

