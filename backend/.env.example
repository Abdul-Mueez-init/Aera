NODE_ENV=development
HOST=127.0.0.1
# Behind a reverse proxy (Render/Railway/Fly/nginx) set HOST=0.0.0.0 and TRUST_PROXY=1
TRUST_PROXY=0
PORT=4000
LOG_LEVEL=info
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_ISSUER="aera-api"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Supabase configuration (required for storage and database)
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-from-supabase"
SUPABASE_JOB_PHOTOS_BUCKET="job-photos"
# OpenStreetMap configuration (no API keys required).
# OSM_USER_AGENT identifies the client to OSM services (required by policy).
OSM_USER_AGENT="AeraFieldService/1.0 (+https://quantixlabs.live)"
# Nominatim base URL for geocoding (address ↔ coordinates).
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
# Overpass API base URL for neighborhood discovery.
OVERPASS_BASE_URL="https://overpass-api.de/api/interpreter"
# Phase 5 — CORS allowlist for customer-facing web build. Comma-separated origins.
# Example: "https://customer.example.com,http://localhost:3000"
# Leave blank for open CORS (development only).
CORS_ORIGINS=""
# Phase 10 Slice D — email notifications (Resend: https://resend.com).
# Free tier: 3,000 emails/month, 100/day, no card required, permanent (not a trial).
# Leave RESEND_API_KEY blank to run without sending real email — safe for
# local/dev/test; sends are skipped with a one-time log warning.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Aera <onboarding@resend.dev>"
# Phase 10 Slice E — push notifications (Firebase Cloud Messaging).
# Completely free, no quota limit, no card required. Get these three values
# from a Firebase service-account JSON key (Firebase Console > Project
# settings > Service accounts > Generate new private key).
# Leave blank to run without sending real push — safe for local/dev/test;
# sends are skipped with a one-time log warning.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Phase 10 Slice F — SMS notifications (textbee.dev — Android SMS gateway).
# Permanent free tier: 300 messages/month, 50/day, no credit card, ever.
# No country restriction — it sends through a real SIM in a real Android
# phone you control, so a Pakistani number works fine. Requires that phone
# (with the textbee app open) to be powered on and online when you want a
# send to go through.
# Leave blank to run without sending real SMS — safe for local/dev/test;
# sends are skipped with a one-time log warning.
TEXTBEE_API_KEY=""
# Phase 11 Slice D — AI Job Assistant model gateway (Google Gemini).
# Free tier via Google AI Studio: no credit card required.
# 1. Go to https://aistudio.google.com/apikey
# 2. Sign in, click "Create API key", choose/create a Google Cloud project
# 3. Copy the key here
# Leave blank to run without real AI replies — safe for local/dev/test; the
# user's message is still saved, the assistant reply is skipped with a
# one-time log warning.
GEMINI_API_KEY=""
# Stable, free-tier-eligible Gemini 3 model. The Gemini 2.5 line (flash,
# flash-lite, pro) is scheduled for shutdown 16 October 2026 — don't switch
# back to it. Change only if Google deprecates this model.
GEMINI_MODEL="gemini-3.1-flash-lite"
# Phase 12 — crash/error reporting (Sentry: https://sentry.io).
# Create a Node.js project in Sentry (platform: Express) and paste its DSN
# (Project Settings > Client Keys). Leave blank to run without Sentry — safe
# for local/dev/test; the SDK is a complete no-op when no DSN is set.
SENTRY_DSN=""
# Defaults to NODE_ENV. Set "staging" / "production" in each deployment.
SENTRY_ENVIRONMENT=""
# Optional: the git commit SHA of the deploy, so issues map to a release.
# Format: aera-api@<commit-sha> or just the commit SHA. Set in CI/CD pipeline.
SENTRY_RELEASE=""
# Fraction of requests traced for performance data (0 to 1). Errors are always
# captured. Keep this low on free plans.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Customer portal configuration. PORTAL_PUBLIC_BASE_URL (https) and
# PORTAL_CODE_SECRET (>=32 chars, different from JWT_SECRET) are REQUIRED
# when NODE_ENV is production or staging — the API refuses to boot without
# them. CORS_ORIGINS is likewise required in production/staging.
PORTAL_PUBLIC_BASE_URL="https://portal.quantixlabs.live"
PORTAL_CODE_SECRET="replace-with-at-least-32-random-characters"
PORTAL_LINK_UNUSED_TTL_HOURS=168
PORTAL_SESSION_IDLE_DAYS=7
PORTAL_SESSION_MAX_DAYS=45
PORTAL_POST_COMPLETION_MAX_DAYS=14
PORTAL_SWEEP_ENABLED=true
PORTAL_SWEEP_MINUTES=60
HANDSHAKE_MAX_ATTEMPTS=5
HANDSHAKE_LOCK_MINUTES=15