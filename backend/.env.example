NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_ISSUER="aera-api"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Phase 10 Slice D — email notifications (Resend: https://resend.com).
# Free tier: 3,000 emails/month, 100/day, no card required, permanent (not a trial).
# Leave RESEND_API_KEY blank to run without sending real email — safe for
# local/dev/test; sends are skipped with a one-time log warning.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Aera <onboarding@resend.dev>"
# Phase 10 Slice E — push notifications (Firebase Cloud Messaging).
# Completely free, no quota limit, no card required. Get these three values
# from a Firebase service-account JSON key (Firebase Console > Project
# settings > Service accounts > Generate new private key).
# Leave blank to run without sending real push — safe for local/dev/test;
# sends are skipped with a one-time log warning.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Phase 10 Slice F — SMS notifications (textbee.dev — Android SMS gateway).
# Permanent free tier: 300 messages/month, 50/day, no credit card, ever.
# No country restriction — it sends through a real SIM in a real Android
# phone you control, so a Pakistani number works fine. Requires that phone
# (with the textbee app open) to be powered on and online when you want a
# send to go through.
# Leave blank to run without sending real SMS — safe for local/dev/test;
# sends are skipped with a one-time log warning.
TEXTBEE_API_KEY=""