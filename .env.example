# Template only. Copy to .env.development / .env.staging / .env.production
# for your own reference. Real values must never be committed.
#
# The Flutter app does not read these files automatically; pass the values
# with --dart-define, for example:
#   flutter run --flavor development --dart-define=ENVIRONMENT=development \
#     --dart-define=API_BASE_URL=https://api.example.com

ENVIRONMENT=development
API_BASE_URL=
# Optional: Custom OSM tile URL (defaults to https://tile.openstreetmap.org/{z}/{x}/{y}.png)
# Use a hosted tile provider for production scale (see docs/onboarding_google_maps_setup.md)
MAP_TILE_URL=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=aera@1.0.0
SENTRY_TRACES_SAMPLE_RATE=1.0
